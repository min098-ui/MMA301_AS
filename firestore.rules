rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is logged in
    function isAuthenticated() {
      return request.auth != null;
    }

    // Users can read/write their own profile
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if request.auth.uid == userId;
    }

    // Teams can be read/written by authenticated users
    match /teams/{teamId} {
      allow read: if isAuthenticated();
      // Only authenticated users can create a team
      allow create: if isAuthenticated();
      // Only owner can update/delete (for simplicity, we allow any auth user in basic rules, or restrict to owner)
      allow update, delete: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
      
      // Messages subcollection
      match /messages/{messageId} {
        allow read, write: if isAuthenticated();
      }
    }

    // Team members can be read/written by authenticated users
    match /teamMembers/{memberId} {
      allow read, write: if isAuthenticated();
    }

    // Tasks can be read/written by authenticated users
    match /tasks/{taskId} {
      allow read, write: if isAuthenticated();
    }
  }
}
